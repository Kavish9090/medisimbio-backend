# ==============================================================================
# MediSimbio Backend Environment Variables Template
# Copy this file to .env and configure your local environment settings.
# DO NOT commit .env with real credentials into version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=medisimbio_db
DB_USERNAME=medisimbio_user
DB_PASSWORD=medisimbio_pass

# Database Connection Pool (HikariCP)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONNECTION_TIMEOUT=20000

# JPA / Hibernate Configuration
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_HIBERNATE_DDL_AUTO=validate

# Flyway Migration Configuration
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# Security Foundation (Future JWT / OAuth2 placeholders)
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET
JWT_EXPIRATION_SECONDS=86400

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
